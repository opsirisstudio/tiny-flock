[gd_scene load_steps=2 format=3]

[ext_resource path="res://scripts/debug/husbandry_lab.gd" type="Script" id="1"]

[node name="HusbandryLab" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
offset_left = 24.0
offset_top = 24.0
offset_right = 900.0
offset_bottom = 620.0

[node name="Title" type="Label" parent="VBox"]
text = "Husbandry Lab — static-prepared developer UI"
[node name="SheepSelector" type="OptionButton" parent="VBox"]
unique_name_in_owner = true
[node name="FoodSelector" type="OptionButton" parent="VBox"]
unique_name_in_owner = true
[node name="Actions" type="HBoxContainer" parent="VBox"]
[node name="Feed" type="Button" parent="VBox/Actions"]
text = "Feed"
[node name="Pet" type="Button" parent="VBox/Actions"]
text = "Pet"
[node name="Groom" type="Button" parent="VBox/Actions"]
text = "Groom"
[node name="Wash" type="Button" parent="VBox/Actions"]
text = "Wash"
[node name="Hour" type="Button" parent="VBox/Actions"]
text = "+1 Hour"
[node name="Day" type="Button" parent="VBox/Actions"]
text = "+1 Day"
[node name="Details" type="RichTextLabel" parent="VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(850, 400)

[connection signal="item_selected" from="VBox/SheepSelector" to="." method="_on_sheep_selected"]
[connection signal="pressed" from="VBox/Actions/Feed" to="." method="_on_feed_pressed"]
[connection signal="pressed" from="VBox/Actions/Pet" to="." method="_on_pet_pressed"]
[connection signal="pressed" from="VBox/Actions/Groom" to="." method="_on_groom_pressed"]
[connection signal="pressed" from="VBox/Actions/Wash" to="." method="_on_wash_pressed"]
